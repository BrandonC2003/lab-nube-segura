#cloud-config
package_update: true
packages:
  - strongswan-swanctl
  - charon-systemd
  - tcpdump

write_files:
  - path: /etc/sysctl.d/99-router.conf
    content: |
      net.ipv4.ip_forward = 1

  - path: /etc/swanctl/conf.d/azure.conf
    permissions: "0600"
    content: |
      connections {
        azure {
          version = 2
          local_addrs = ${ip_local}
          remote_addrs = ${ip_vpn_azure}
          proposals = aes256-sha256-modp2048
          dpd_delay = 30s
          local {
            auth = psk
            id = ${ip_publica_sede}
          }
          remote {
            auth = psk
            id = ${ip_vpn_azure}
          }
          children {
            redes-azure {
              local_ts = ${rango_sede}
              remote_ts = ${rangos_azure}
              esp_proposals = aes256-sha256-modp2048
              start_action = start
              dpd_action = restart
              close_action = start
            }
          }
        }
      }
      secrets {
        ike-azure {
          id-1 = ${ip_publica_sede}
          id-2 = ${ip_vpn_azure}
          secret = "${psk}"
        }
      }

runcmd:
  - sysctl --system
  - systemctl enable strongswan
  - systemctl restart strongswan
  - swanctl --load-all